{
  "name": "dsh-skill-tag",
  "version": "0.1.8",
  "description": "给 DSH 的技能（skill）打标签，用一条布尔表达式在「工作区 / 对话」两级选出要下发给模型的技能子集",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aawef/dsh-skill-manager-tags.git"
  },
  "homepage": "https://github.com/aawef/dsh-skill-manager-tags#readme",
  "bugs": {
    "url": "https://github.com/aawef/dsh-skill-manager-tags/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "skill",
    "tag",
    "filter"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "skills",
    "docs",
    "tools",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\" \"tests/*.mjs\"",
    "test:unit": "node --test \"tests/*.test.mjs\""
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 <5"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1 <1.0.0"
  }
}
